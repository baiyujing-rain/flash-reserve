<view class="demo" wx:if="{{demo}}">本地演示 · 非真实门店活动</view><view class="error" wx:if="{{error}}">{{error}}</view><block wx:if="{{event}}"><image wx:if="{{event.banner}}" class="banner" src="{{event.banner}}" mode="widthFix"/><view wx:else class="hero"><view class="hero-ring"></view><view class="hero-title"><view>好物限时</view><view>如约而至</view></view><view class="hero-note">每一份期待，都值得如约发生</view><view class="hero-ticket">快闪入场券</view></view><view class="page event-page"><view class="card"><view class="row"><view class="title">{{event.name}}</view><text class="tag" wx:if="{{event.demo}}">演示</text></view><view class="sub">{{event.location}}</view><view class="sub">{{event.timeText}}</view><view class="sub">每人限约 {{event.per_limit}} 个名额</view><view class="countdown-box" wx:if="{{upcoming}}"><view class="muted">距开放预约还有</view><view class="countdown">{{countdown}}</view><view class="muted">到点自动开放，无需刷新</view></view><button class="remind" wx:if="{{upcoming ? canRemind : false}}" bindtap="remind">订阅开抢提醒</button></view><view class="card"><view class="title">选择入场时段</view><view wx:for="{{slots}}" wx:key="id" class="slot {{slotId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="select"><view><view>{{item.label}}</view><view class="muted">{{item.timeText}}</view></view><text class="tag">{{item.paused?'已暂停':'余 '+item.available+' 个'}}</text></view></view><view class="card"><view class="title">预约须知</view><text class="notices">{{event.notices}}</text></view><checkbox-group bindchange="agree"><label class="agreement"><checkbox value="agree" checked="{{agreed}}" color="#4e7943"/><text>我已阅读预约须知，同意仅本人预约与到店核销。</text></label></checkbox-group><view class="note"><text class="privacy-link" bindtap="privacy">手机号使用与隐私说明</text></view><view class="note">名额有限，感谢每一份期待。</view></view><view class="bottom"><view class="stock"><text class="stock-count">{{available}}</text> 个名额<view class="muted">余量自动更新</view></view><button wx:if="{{demo}}" class="primary" disabled="{{!ready||busy}}" bindtap="demoBook">{{buttonText}}</button><button wx:elif="{{!phone}}" class="primary" disabled="{{!ready||busy||!agreed}}" open-type="getPhoneNumber" bindgetphonenumber="phone">{{ready?'授权手机号并预约':buttonText}}</button><button wx:else class="primary" disabled="{{!ready||busy}}" bindtap="reserve">{{buttonText}}</button></view></block>
