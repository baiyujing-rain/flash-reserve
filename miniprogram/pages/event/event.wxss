.banner{width:100%;display:block}.event-page{padding-bottom:220rpx}.countdown-box{background:#f1f6e9;text-align:center;border-radius:15rpx;padding:25rpx;margin-top:25rpx}.countdown{font-size:50rpx;color:#587b45;letter-spacing:6rpx;line-height:1.6}.slot{display:flex;align-items:center;justify-content:space-between;gap:15rpx;border:2rpx solid #e5ebdc;border-radius:14rpx;padding:20rpx;margin-top:20rpx;font-size:25rpx}.slot.selected{border-color:#7f9f6e;background:#f4f8ee}.notices{font-size:25rpx;color:#8c9d7f;white-space:pre-wrap;display:block;margin-top:20rpx}.bottom{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1rpx solid #e1e9d8;padding:22rpx 30rpx;padding-bottom:calc(22rpx + env(safe-area-inset-bottom));display:flex;justify-content:space-between;gap:25rpx;align-items:center}.bottom button{width:370rpx;font-size:27rpx}.stock{font-size:23rpx;color:#8b9e7d}.stock-count{font-size:42rpx;color:#557a44;font-weight:600}.agreement{display:flex;gap:10rpx;font-size:22rpx;color:#93a285;align-items:flex-start}.agreement checkbox{transform:scale(.7);transform-origin:top left;width:40rpx}.remind{margin-top:22rpx;font-size:23rpx;background:#eef4e6;color:#6f8e5a}
