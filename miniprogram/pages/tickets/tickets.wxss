.ticket{background:white;border:1rpx solid #dfe8d5;border-radius:22rpx;overflow:hidden;margin:35rpx 0}.ticket-head{background:#eaf2df;padding:40rpx;text-align:center}.ticket-body{padding:35rpx;border-top:2rpx dashed #d9e6c9}.number{font-size:88rpx;font-weight:600;color:#557441;text-align:center;line-height:1.2;letter-spacing:4rpx}.ticket-body>.note{margin-top:8rpx}.code{text-align:center;font-size:36rpx;letter-spacing:5rpx;background:#f6f9f1;border:1rpx solid #e7eddd;border-radius:12rpx;padding:22rpx;margin:35rpx 0}.code .muted{font-size:20rpx;letter-spacing:0;margin-top:10rpx}.detail{display:flex;justify-content:space-between;gap:30rpx;font-size:24rpx;color:#8b9d7b;margin:18rpx 0}.detail text:last-child{text-align:right;color:#607e4d;max-width:400rpx}
