page{background:#f5f8f0;color:#375437;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.7}view,text,button,input{box-sizing:border-box}button{font-size:26rpx;border-radius:14rpx}button::after{border:0}.page{padding:32rpx 30rpx 60rpx}.brand{font-size:38rpx;font-weight:600;letter-spacing:4rpx}.muted{color:#98a88c;font-size:23rpx}.card{padding:34rpx;background:white;border:1rpx solid #e5ecd9;border-radius:20rpx;margin:24rpx 0}.primary{background:#4e7943;color:white;padding:16rpx 28rpx}.primary[disabled]{background:#e0e7d8;color:#99a58c}.title{font-size:32rpx;font-weight:600}.sub{font-size:23rpx;color:#96a389;margin-top:12rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.demo{background:#fff1d8;color:#a28c5a;font-size:21rpx;padding:8rpx 20rpx;text-align:center}.tag{font-size:21rpx;background:#edf4e5;padding:4rpx 14rpx;border-radius:8rpx;color:#7c9666}.note{font-size:21rpx;color:#a3af96;text-align:center;margin-top:35rpx}.error{font-size:23rpx;color:#b18252;background:#fff5e3;padding:18rpx 25rpx}.link{color:#7c9567;font-size:23rpx}.hero{padding:50rpx 40rpx;background:#244b3a;color:#e7edd6;min-height:350rpx;position:relative;overflow:hidden}.hero-title{font-size:64rpx;letter-spacing:10rpx;line-height:1.5;font-weight:500}.hero-note{font-size:22rpx;letter-spacing:3rpx;color:#b7c7a6;margin-top:25rpx}.hero-ring{position:absolute;width:380rpx;height:380rpx;border:55rpx solid #63815d44;border-radius:50%;right:-110rpx;top:40rpx}.hero-ticket{position:absolute;right:35rpx;bottom:45rpx;background:#dfedbb;color:#526d3c;border-radius:18rpx;padding:16rpx 30rpx;transform:rotate(-12deg);font-size:24rpx}.empty{padding:80rpx 30rpx;text-align:center;color:#96a889;font-size:26rpx}.empty-title{font-size:35rpx;margin-bottom:20rpx;color:#68845a}.privacy-link{color:#4e7943;text-decoration:underline}
